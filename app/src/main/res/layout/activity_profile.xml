<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD230"
    android:padding="16dp">

    <!-- Leftmost Circle -->

    <!-- Back Arrow -->

    <!-- Profile Text -->

    <View
        android:id="@+id/left_circle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/circle_white" />

    <ImageView
        android:id="@+id/arrow_back"
        android:layout_width="26dp"
        android:layout_height="36dp"
        android:layout_alignStart="@id/left_circle"
        android:layout_marginStart="5dp"
        android:layout_marginTop="22dp"
        android:src="@drawable/ic_arrow_black" />

    <!-- Separator Line -->
    <TextView
        android:id="@+id/profile_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="143dp"
        android:layout_marginTop="38dp"
        android:text="Profile"
        android:textColor="#000000"
        android:textSize="36sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="19dp"
        android:layout_below="@id/profile_text"
        android:background="@android:color/background_light" />

    <!-- Profile Circle -->
    <RelativeLayout
        android:id="@+id/profile_circle"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:layout_marginTop="140dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/circle_with_image">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="48dp"
            android:layout_marginTop="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_girl" />
    </RelativeLayout>

    <!-- Name Button -->
    <RelativeLayout
        android:id="@+id/name_button"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="37dp"
        android:layout_marginTop="270dp"
        android:background="@drawable/rounded_button"
        android:text="Name"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="normal"
        android:textposition="before" />

    <!-- Mobile Number Button -->
    <RelativeLayout
        android:id="@+id/mobile_button"
        android:layout_width="330dp"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="39dp"
        android:layout_marginTop="355dp"
        android:background="@drawable/rounded_button"
        android:text="  Mobile Number"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="normal" />

    <!-- Email ID Button -->
    <RelativeLayout
        android:id="@+id/email_button"
        android:layout_width="330dp"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="37dp"
        android:layout_marginTop="440dp"
        android:background="@drawable/rounded_button"
        android:text="Email ID"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="normal" />

    <!-- Enter Age Button -->
    <RelativeLayout
        android:id="@+id/age_button"
        android:layout_width="330dp"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="37dp"
        android:layout_marginTop="525dp"
        android:background="@drawable/rounded_button"
        android:text="Enter Your Age"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="normal" />
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD230">

    <!-- Circle -->
    <RelativeLayout
        android:id="@+id/circle_layout"
        android:layout_width="114dp"
        android:layout_height="114dp"
        android:layout_marginStart="136dp"
        android:layout_marginTop="98dp"
        android:background="@drawable/circle_with_stroke"
        android:layout_centerHorizontal="true">

        <!-- Checkmark Icon -->
        <ImageView
            android:id="@+id/check_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_check"
            app:tint="#000000" />
    </RelativeLayout>

    <!-- Title Text: "Successful" -->
    <TextView
        android:id="@+id/success_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="105dp"
        android:layout_marginTop="244dp"
        android:text="Successful"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <!-- Description Text -->
    <TextView
        android:id="@+id/congrats_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="302dp"
        android:text="Congratulations! Your password has been changed. Click continue to login."
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_centerHorizontal="true"
        android:gravity="center" />

    <!-- Continue Button -->
    <RelativeLayout
        android:id="@+id/continue_button"
        android:layout_width="342dp"
        android:layout_height="65dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="391dp"
        android:background="@drawable/rounded_button"
        android:layout_centerHorizontal="true">

        <TextView
            android:id="@+id/continue_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Continue"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </RelativeLayout>
</RelativeLayout>
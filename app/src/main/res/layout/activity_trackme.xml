<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD230">

    <!-- Circle with back arrow -->

    <View
        android:id="@+id/left_circle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/circle_white" />


    <ImageView
        android:id="@+id/arrow_icon"
        android:layout_width="38dp"
        android:layout_height="31dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/arrow_icon" />


    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="69dp"
        android:layout_marginTop="11dp"
        android:src="@drawable/ic_profile_girl"
        android:id="@+id/profile_icon" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="154dp"
        android:layout_marginTop="23dp"
        android:text="Tracker"
        android:textColor="#000000"
        android:textSize="26dp"
        android:id="@+id/tracker_text" />

    <!-- Real-time Map -->
    <FrameLayout
        android:layout_width="405dp"
        android:layout_height="815dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="74dp"
        android:background="#FF7777"
        android:id="@+id/map_container">

        <!-- This container will hold the Google Map -->
    </FrameLayout>

    <!-- Send Friends Button -->
    <RelativeLayout
        android:layout_width="319dp"
        android:layout_height="54dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="667dp"
        android:layout_marginBottom="20dp"
        android:elevation="4dp"
        android:id="@+id/send_friends_button"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:backgroundTint="#FFD230"
        android:backgroundTintMode="src_in"
        android:layout_gravity="center"
        android:background="@drawable/button_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send Friends"
            android:layout_centerInParent="true"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            android:id="@+id/send_friends_text" />
    </RelativeLayout>

</RelativeLayout>